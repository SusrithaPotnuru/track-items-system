# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/timesheet-db

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# AES Encryption (for SMTP password at rest)
AES_SECRET_KEY=your_32_char_aes_key_here_exactly

# CORS
CLIENT_URL=http://localhost:5173

# Default Admin (seed script)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin@1234
